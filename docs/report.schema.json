{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outofstate.dev/schema/report.v1.json",
  "title": "Out of State report",
  "description": "JSON report written by 'oos --format json'. Compatibility rules for schema_version 1: new optional fields and new enum values may be added; consumers must ignore fields they do not know. Removing or renaming a field, or changing its type or meaning, requires a new schema_version.",
  "type": "object",
  "required": ["schema_version", "scan", "regions", "sources", "summary", "findings", "warnings", "cost"],
  "properties": {
    "schema_version": { "const": 1 },
    "scan": {
      "type": "object",
      "required": ["time", "oos_version", "partition", "account_id", "regions", "complete", "state_complete", "discovery_complete"],
      "properties": {
        "time": { "type": "string", "format": "date-time" },
        "oos_version": { "type": "string" },
        "partition": { "type": "string", "minLength": 1 },
        "account_id": { "type": "string", "pattern": "^[0-9]{12}$" },
        "regions": { "type": "array", "items": { "type": "string" } },
        "complete": { "type": "boolean", "description": "state_complete AND discovery_complete" },
        "state_complete": { "type": "boolean", "description": "no Terraform source failed, and every snapshot used for matching parsed fully (older snapshots of the same state are ignored)" },
        "discovery_complete": { "type": "boolean", "description": "every region was scanned successfully" }
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["region", "status", "instance_count"],
        "properties": {
          "region": { "type": "string" },
          "resource_type": { "type": "string", "description": "Terraform resource type scanned, e.g. aws_db_instance or aws_lb (one entry per region and type)" },
          "status": { "enum": ["ok", "failed"] },
          "error_category": { "type": "string", "description": "access_denied, throttled, timeout, region_disabled, api_error" },
          "error": { "type": "string", "description": "fixed message for error_category" },
          "instance_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "workspace", "status", "lineage", "serial", "identity_count", "observed_at"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "enum": ["file", "directory"] },
          "workspace": { "type": "string", "description": "'unknown' for state files" },
          "status": { "enum": ["ok", "partial", "failed"] },
          "error_category": { "type": "string" },
          "error": { "type": "string", "description": "fixed message for error_category; never Terraform output" },
          "hint": { "type": "string", "description": "command to run by hand to see Terraform's own output" },
          "lineage": { "type": ["string", "null"] },
          "serial": { "type": ["integer", "null"] },
          "identity_count": { "type": "integer", "minimum": 0 },
          "problems": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "address": { "type": "string" },
                "resource_type": { "type": "string" },
                "kind": { "type": "string" }
              }
            }
          },
          "observed_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["tracked", "no_match", "unable_to_verify", "not_covered"],
      "properties": {
        "tracked": { "type": "integer", "minimum": 0 },
        "no_match": { "type": "integer", "minimum": 0 },
        "unable_to_verify": { "type": "integer", "minimum": 0 },
        "not_covered": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } },
    "cost": {
      "oneOf": [
        { "type": "null", "description": "cost was not requested (--cost not given)" },
        {
          "type": "object",
          "required": ["available"],
          "properties": {
            "available": { "type": "boolean" },
            "reason": { "type": "string", "description": "when unavailable: partition_not_supported, access_denied, cost_explorer_not_enabled, throttled, timeout, api_error, mixed_currency, data_unavailable" },
            "message": { "type": "string" },
            "scope": { "type": "string", "description": "what the totals cover: all RDS charges in the scanned account and regions, not the cost of particular findings" },
            "metric": { "type": "string" },
            "currency": { "type": "string" },
            "periods": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "label", "start", "end", "total", "estimated", "breakdown"],
                "properties": {
                  "name": { "enum": ["last_6_months", "last_30_days"] },
                  "label": { "type": "string" },
                  "start": { "type": "string", "format": "date", "description": "inclusive" },
                  "end": { "type": "string", "format": "date", "description": "exclusive" },
                  "total": { "$ref": "#/$defs/decimal" },
                  "estimated": { "type": "boolean" },
                  "breakdown": {
                    "type": "object",
                    "required": ["instances", "multi_az", "storage", "backup", "proxy", "other"],
                    "additionalProperties": { "$ref": "#/$defs/decimal" }
                  }
                }
              }
            }
          },
          "if": { "properties": { "available": { "const": true } } },
          "then": { "required": ["scope", "metric", "currency", "periods"] },
          "else": { "required": ["reason"] }
        }
      ]
    }
  },
  "$defs": {
    "decimal": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$", "description": "exact decimal amount, never a float" },
    "finding": {
      "type": "object",
      "required": ["resource_type", "status", "partition", "account_id", "region", "arn", "identifier", "resource_id", "import_id", "engine", "engine_version", "class", "instance_status", "tags", "matches", "warnings"],
      "properties": {
        "resource_type": { "type": "string", "description": "Terraform resource type: aws_db_instance, aws_lb, aws_s3_bucket, aws_lambda_function or aws_nat_gateway" },
        "kind": { "type": "string", "description": "short label: rds, alb, nlb, gwlb, s3, lambda, nat" },
        "details": { "type": "object", "additionalProperties": { "type": "string" }, "description": "type-specific details: scheme and vpc_id for load balancers; runtime, package_type, architecture and last_modified for Lambda functions; name, vpc_id, availability_mode, connectivity_type and subnet_id (zonal only) for NAT gateways" },
        "status": { "enum": ["tracked", "no_match", "unable_to_verify", "not_covered"] },
        "not_covered_reason": { "type": "string" },
        "partition": { "type": "string" },
        "account_id": { "type": "string" },
        "region": { "type": "string" },
        "arn": { "type": "string" },
        "identifier": { "type": "string" },
        "resource_id": { "type": "string" },
        "import_id": { "type": "string", "description": "the ID 'terraform import' expects for resource_type" },
        "engine": { "type": "string" },
        "engine_version": { "type": "string" },
        "class": { "type": "string" },
        "instance_status": { "type": "string" },
        "created": { "type": "string", "format": "date-time" },
        "tags": { "type": "object", "additionalProperties": { "type": "string" } },
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "workspace", "address", "lifecycle", "matched_on", "weak", "renamed"],
            "properties": {
              "source": { "type": "string" },
              "workspace": { "type": "string" },
              "address": { "type": "string" },
              "lifecycle": { "enum": ["current", "tainted", "deposed"] },
              "deposed_key": { "type": "string" },
              "matched_on": { "enum": ["resource_id", "arn", "identifier"] },
              "weak": { "type": "boolean", "description": "true when the match could not use the resource type's strongest identity (resource_id for RDS, the ARN for load balancers and Lambda functions, bucket name plus recorded region for S3, gateway ID plus recorded account and region for NAT gateways)" },
              "renamed": { "type": "boolean" }
            }
          }
        },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "tracked" } } },
          "then": { "properties": { "matches": { "minItems": 1 } } },
          "else": { "properties": { "matches": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "status": { "const": "not_covered" } } },
          "then": { "required": ["not_covered_reason"] }
        }
      ]
    },
    "warning": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["multiple_owners", "multiple_addresses", "stale_state_entry", "duplicate_snapshot", "diverged_copies", "tags_unavailable", "managed_by_other_tool", "likely_created_by"], "description": "diverged_copies: several snapshots of one state (same lineage, different serial); only the first source listed, the newest, was used for matching" },
        "tool": { "type": "string", "description": "managed_by_other_tool (from tags): cloudformation, elastic_beanstalk or kubernetes; likely_created_by (from a name convention): cdk, cloudformation or elastic_beanstalk for S3 buckets, control_tower for Lambda functions" },
        "sources": { "type": "array", "items": { "type": "string" } },
        "addresses": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
