#!/usr/bin/env bash
# Fake terraform for the e2e self-test. Adds and removes instances in $FAKE_DB.
set -euo pipefail
: "${TF_VAR_run_id:?}"
dir="${1#-chdir=}"; shift
project="$(basename "$dir")"
echo "terraform $project $*" >> "$FAKE_CALLS"
add() {
  jq --arg id "oos-e2e-${TF_VAR_run_id}-$1" --arg run "$TF_VAR_run_id" \
    '.DBInstances += [{"DBInstanceIdentifier": $id, "TagList": [{"Key": "oos-e2e", "Value": $run}]}]' \
    "$FAKE_DB" > "$FAKE_DB.$$" && mv "$FAKE_DB.$$" "$FAKE_DB"
}
remove_project() {
  local p; p="$( [ "$project" = project-a ] && echo a || echo b )"
  jq --arg pre "oos-e2e-${TF_VAR_run_id}-$p" '.DBInstances |= map(select(.DBInstanceIdentifier | startswith($pre) | not))' \
    "$FAKE_DB" > "$FAKE_DB.$$" && mv "$FAKE_DB.$$" "$FAKE_DB"
}
case "$1" in
  init) exit 0 ;;
  apply)
    trap 'echo "terraform $project interrupted" >> "$FAKE_CALLS"; exit 143' TERM
    if [ "$project" = project-a ]; then add a1; else add b1; fi
    if [ "$project" = project-a ] && [ -n "${FAKE_INJECT:-}" ]; then
      jq --argjson extra "$FAKE_INJECT" '.DBInstances += $extra' "$FAKE_DB" > "$FAKE_DB.$$" && mv "$FAKE_DB.$$" "$FAKE_DB"
    fi
    if [ "${FAKE_APPLY_FAIL:-}" = "$project" ]; then exit 1; fi
    sleep "${FAKE_APPLY_SLEEP:-0}" & wait $!
    if [ "$project" = project-b ]; then add b2; fi
    exit 0 ;;
  destroy)
    if [ "${FAKE_DESTROY_FAIL:-}" = "1" ]; then exit 1; fi
    remove_project; exit 0 ;;
  *) echo "fake terraform: unexpected $*" >&2; exit 99 ;;
esac
