#!/usr/bin/env bash
# jq programs are single-quoted on purpose.
# shellcheck disable=SC2016
# Fake aws CLI for the e2e self-test. State lives in $FAKE_DB (JSON).
set -euo pipefail
echo "aws $*" >> "$FAKE_CALLS"
# The fakes run concurrently (two applies), so every change to $FAKE_DB is
# serialised with a mkdir lock.
update_db() {
  until mkdir "$FAKE_DB.lock" 2>/dev/null; do sleep 0.05; done
  jq "$@" "$FAKE_DB" > "$FAKE_DB.$$" && mv "$FAKE_DB.$$" "$FAKE_DB"
  rmdir "$FAKE_DB.lock"
}
case "$1 $2" in
  "rds describe-db-instances") cat "$FAKE_DB" ;;
  "rds delete-db-instance")
    id="$4"
    if [ "${FAKE_DELETE_FAIL:-}" = "1" ]; then exit 1; fi
    update_db --arg id "$id" '.DBInstances |= map(select(.DBInstanceIdentifier != $id))' ;;
  "rds wait") [ "${FAKE_DELETE_FAIL:-}" = "1" ] && exit 1; exit 0 ;;
  *) echo "fake aws: unexpected $*" >&2; exit 99 ;;
esac
